{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decisions.schema.json",
  "title": "Design decisions with requirement links and verifiable constraints",
  "type": "object",
  "required": ["project", "direction", "decisions", "constraints"],
  "additionalProperties": false,
  "properties": {
    "project": { "type": "string" },
    "direction": { "type": "string", "pattern": "^dir-[0-9]+$" },
    "seed": { "type": "integer" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "axis", "choice", "based_on", "rationale", "source", "verified_by"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^d-[a-z]+-[0-9]+$" },
          "axis": { "enum": ["style", "palette", "typography", "layout", "motion", "tone"] },
          "choice": { "type": "string", "minLength": 3 },
          "based_on": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^req-[a-z0-9_.-]+$" }
          },
          "rationale": { "type": "string", "minLength": 10 },
          "source": { "enum": ["stated", "sampled", "client-picked"] },
          "realized_by": {
            "description": "Token paths in tokens.json, or layout pattern ids.",
            "type": "array",
            "items": { "type": "string" }
          },
          "verified_by": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^c-[a-z0-9-]+$" }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^c-[a-z0-9-]+$" },
          "kind": {
            "enum": ["var-used", "token-equals", "pattern-present", "contrast-min", "motion-max", "register"]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "var-used" } } },
            "then": {
              "required": ["selector", "property", "var"],
              "properties": {
                "selector": { "type": "string" },
                "property": { "type": "string" },
                "var": { "type": "string", "pattern": "^--pd-[a-z0-9-]+$" }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "token-equals" } } },
            "then": {
              "required": ["token", "value"],
              "properties": { "token": { "type": "string" }, "value": {} }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "pattern-present" } } },
            "then": {
              "required": ["pattern"],
              "properties": { "pattern": { "type": "string" }, "page": { "type": "string" } }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "contrast-min" } } },
            "then": {
              "required": ["fg", "bg", "ratio"],
              "properties": {
                "fg": { "type": "string" },
                "bg": { "type": "string" },
                "ratio": { "type": "number", "minimum": 1 }
              }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "motion-max" } } },
            "then": {
              "required": ["level"],
              "properties": { "level": { "enum": ["none", "low", "medium"] } }
            }
          },
          {
            "if": { "properties": { "kind": { "const": "register" } } },
            "then": {
              "required": ["lang", "pronoun"],
              "properties": {
                "lang": { "enum": ["id", "en"] },
                "pronoun": { "enum": ["kamu", "Anda", "you"] }
              }
            }
          }
        ]
      }
    }
  }
}
